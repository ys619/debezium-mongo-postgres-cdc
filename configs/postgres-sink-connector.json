{
  "name": "postgres-sink-connector",
  "config": {
    "connector.class": "io.confluent.connect.jdbc.JdbcSinkConnector",
    "tasks.max": "1",
    "topics": "cdc.inventory.customers",
    "connection.url": "jdbc:postgresql://postgres:5432/inventory_sink",
    "connection.user": "postgres",
    "connection.password": "postgres_password",
    "auto.create": "true",
    "auto.evolve": "true",
    "insert.mode": "upsert",
    "pk.mode": "record_key",
    "pk.fields": "id"
  }
}
